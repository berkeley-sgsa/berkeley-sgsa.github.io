al-park","label":"Yosemite National Park","html_id":"yosemite-national-park","implicit":true,"key":"vyaOppRq00"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"About 4 hours from campus, Yosemite is one of the most famous national parks and has numerous draws: hiking, beautiful views, camping, and climbing. If you plan to camp, you must schedule as soon as spots are open for the season as they fill up fast. It can get especially crowded during summer holidays and is often closed in the winter months due to snowfall.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"YJP31V0RXq"}],"key":"pxb0qa04jy"},{"type":"image","url":"/build/yosemite-0335315dd446084dd61f7c7624ee323d.jpg","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"JsbvTtTTVE","urlSource":"/assets/hiking/yosemite.jpg"},{"type":"image","url":"/build/sierras-01776ec48eb1e139c4b1f0cef81aa62e.jpg","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"MHTeRx7Xrv","urlSource":"/assets/hiking/sierras.jpg"},{"type":"heading","depth":3,"position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Redwoods National Park","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"iwWEijzDf3"}],"identifier":"redwoods-national-park","label":"Redwoods National Park","html_id":"redwoods-national-park","implicit":true,"key":"pAlYEqsgFf"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"About 5 hours from campus in Northern California, Redwoods National Park is nestled adjacent land of the Yurok Tribe. It includes huge old growth redwood tree groves, fern forests, and rivers.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"A8L6oi0Lwd"}],"key":"L9XQAYcKIr"}],"key":"M