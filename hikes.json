-aptos","label":"Santa Cruz Mountains - Santa Cruz, Boulder Creek, Aptos","html_id":"santa-cruz-mountains-santa-cruz-boulder-creek-aptos","implicit":true,"key":"gk7w8gWqjZ"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"The Sata Cruz Mountains are about a 1.5-2 hour drive depending on traffic and make for a great day trip.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"T1zTUhtxfF"}],"key":"umGLcGBrOa"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":84,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Big Basin State Park","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"XUNibpYzbK"}],"key":"rtdUT1IHZZ"},{"type":"text","value":": Known for its redwood tree trails, large park with trails of all skill levels and distances.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"cgy50PjCDz"}],"key":"il6JlMCKuw"}],"key":"VWSH6IBofj"},{"type":"listItem","spread":true,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Henery Cowl State Park","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"IjlHrISyl1"}],"key":"seabAV3xig"},{"type":"text","value":": Smaller park in the Santa Cruz Mountains. Has campgrounds, trails to the observation deck, swimming holes, and is adjacent to a historical railroad park.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"CQbD