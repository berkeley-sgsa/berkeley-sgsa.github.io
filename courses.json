{"version":3,"kind":"Article","sha256":"80f137f69b126d9de8a618311698bf6fdaa39ef25b241a749b2f9427036f97a0","slug":"courses","location":"/pages/courses.md","dependencies":[],"frontmatter":{"title":"Courses","content_includes_title":false,"github":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io/blob/main/pages/courses.md","edit_url":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io/edit/main/pages/courses.md","exports":[{"format":"md","filename":"courses.md","url":"/build/courses-12d5059702f4f00c37365189145b676f.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here is a list of courses that students in the statistics department commonly take. Course offerings for each semester can be found ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z4x7jpnf9o"},{"type":"link","url":"https://classes.berkeley.edu/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"here","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FUxaeZliBj"}],"urlSource":"https://classes.berkeley.edu/","key":"I4o40wmJ87"},{"type":"text","value":" and are usually announced in the middle of the semester for the following semester. One useful resource for course notes is Daniel Raban’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q7akkijIKL"},{"type":"link","url":"https://pillowmath.github.io","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Pillowmath note repository","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"H4HOEx9rLv"}],"urlSource":"https://pillowmath.github.io","key":"icB6VNs2Wj"},{"type":"text","value":", which has notes for Stat 210A, 210B, and some other courses.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GpeOIwrAP8"}],"key":"NJQBaMXf0I"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Core courses","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IND4E5EWE6"}],"identifier":"core-courses","label":"Core courses","html_id":"core-courses","implicit":true,"key":"JqPTPrH82z"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"In their first year, PhD students will usually take 4 of the 6 core courses (2 per semester), depending on their area of specialization. The core courses are 205A and 205B (probability theory), 210A and 210B (theoretical statistics), and 215A and 215B (applied statistics). For example, common courseloads might be:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Arbh1sPQo0"}],"key":"SmpmmbfcJm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(For a student interested in applied statistics) Fall semester: 210A, 215A; Spring semester: 210B, 215B","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"fSXaCmwi7x"}],"key":"GFU3gn1zNJ"}],"key":"vRy2tIDmcJ"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"(For a student interested in theoretical statistics or probability theory) Fall semester: 205A, 210A; Spring semester: 205B, 210B","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"xDzi1qwvuQ"}],"key":"XmSX9Ut4EV"}],"key":"JYtFdcOP6y"}],"key":"oHmrwT671H"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Students may deviate from this template for a number of reasons, such as:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"D8vowuBzEC"}],"key":"SyhwKz3GZW"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":14,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If you are interested in interdisciplinary work, you may wish to include a course from another department.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"FWMCLS73pg"}],"key":"KqvhvU656V"}],"key":"vwzf9W6bCj"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If you have done graduate work at another university, the material in the “A” courses may already be familiar to you (or it may not). Other courses may be more appropriate.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"B87F8H4foE"}],"key":"F9dubKOnvZ"}],"key":"iWoLb1BaDd"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If you would like to learn probability theory but not at the level of rigor required for research, you may want to take Stat 204 (which is only occasionally offered).","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"fLulWHUF09"}],"key":"EL8qPQhtsW"}],"key":"xwtd244QBr"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If you feel that you need a stronger mathematical background before taking the core courses, you might take an undergraduate course like Math 104 (real analysis) in your first year, postponing a course like Stat 210B to your second year.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"IkEceejdpG"}],"key":"MKkBN0Gt3p"}],"key":"sS85OzBIRp"}],"key":"rnG7upLQJK"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"However, to deviate from the core course requirements, you will need to consult with the graduate advisor to receive approval. Detailed information about the requirements can be found on the department ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"jNcgOZEj0p"},{"type":"link","url":"https://statistics.berkeley.edu/academics/phd/program","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"website","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"t6fb4lMaiW"}],"urlSource":"https://statistics.berkeley.edu/academics/phd/program","key":"xejsKohwgJ"},{"type":"text","value":".","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"otBqzwHqqI"}],"key":"iqkA5g4owE"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"All of the core courses require a large commitment of time, and they tend to have a significant amount of homework. Taking more than two of them per semester (eight units) is a Herculean task. Everybody is required by the university to be enrolled in 12 units, but you can enroll in “filler” units to bring you up to this level. The department also offers courses beyond the core that are more research oriented. They complement the core courses and typically focus on reading and presenting papers, rather than weekly homework. Also, keep in mind that your thesis topic does not need to come from a general area covered by the courses you take in first year: some students who take 205 and 215 in their first year end up working on theoretical statistics, and so on.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"RHwfAldFDp"}],"key":"rUrY9Il1OA"},{"type":"heading","depth":3,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Stat 205: Probability Theory","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"NO1HYWfodT"}],"identifier":"stat-205-probability-theory","label":"Stat 205: Probability Theory","html_id":"stat-205-probability-theory","implicit":true,"key":"qJe9O1YHcB"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Stat 205A and 205B offer a mathematically rigorous treatment of probability theory. The courses generally assume a strong mathematical background, and students without a few real analysis classes under their belt will find the pace quick.  Some knowledge of measure theory is extremely helpful; the basics of measure theory are covered in the first few weeks of lectures, but students who haven’t seen it before often find this isn’t enough. The homework given in this course is time-consuming and hard. Students often form study groups to share ideas.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"CTldT4XpgU"}],"key":"x0phW9wNG8"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"205A: Measure theoretic approach to probability, conditional expectation, martingales.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ObtZ1tpPWq"}],"key":"qFNdUoln5W"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"205B: Markov processes, limit theorems, characteristic functions, ergodic theory, brownian motion.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"HdBc6QrLFn"}],"key":"fZWo2MWxeH"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Stat 210: Theoretical Statistics","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"BnxKu5zc8u"}],"identifier":"stat-210-theoretical-statistics","label":"Stat 210: Theoretical Statistics","html_id":"stat-210-theoretical-statistics","implicit":true,"key":"MYYRVRirj4"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"210A covers as much of classical statistics as is possible in one semester. 210B focuses more on high-dimensional statistics, attempting to bring students to the point where they can start reading research papers in modern topics. The 210 courses are less mathematically rigorous than the 205 courses. 210A is generally considered easier than 205A; 210B is much more mathematically demanding than 210A, and students benefit from a strong background in linear algebra and real analysis. Homework is time-consuming.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"eHAjL9uB7R"}],"key":"a2O05LrTwe"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"210A: The frequentist approach to statistics with comparison to Bayesian and decision theory alternatives, estimation, model assessment, testing, confidence regions, some asymptotic theory.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"bgidKDriCA"}],"key":"jMIgKmFC5K"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"210B: Concentration inequalities, empirical processes, metric entropy, covariance matrix estimation, sparse linear regression, principle component analysis, minimax lower bounds, assorted further topics.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"zTXyUQyfUG"}],"key":"Ks6P9rYhWc"},{"type":"heading","depth":3,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Stat 215: Statistical Models: Theory and Application","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"zlW7K24ZFF"}],"identifier":"stat-215-statistical-models-theory-and-application","label":"Stat 215: Statistical Models: Theory and Application","html_id":"stat-215-statistical-models-theory-and-application","implicit":true,"key":"tRUyCGL7xM"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"There are computing/data analysis assignments as well as readings; sometimes there is additional homework. How these courses are run depend a lot on the instructor. Usually they are discussion-based.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"LDResvV32T"}],"key":"IVkTM9cv1h"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"215A: Exploratory techniques; critical readings of applied papers; overview of methods, including regression, testing, and resampling.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"YQ09Qhlqk3"}],"key":"un5zzouGf5"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"215B: Topics include advanced regression, causal inference, and optimization.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"wkFeEKpFlK"}],"key":"xvxUt1nXXN"},{"type":"heading","depth":2,"position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Other Regular Courses","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"CeuRCYMucv"}],"identifier":"other-regular-courses","label":"Other Regular Courses","html_id":"other-regular-courses","implicit":true,"key":"Cmg9qvVUCc"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"STAT 238 Bayesian Statistics","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Ecv9IPACb7"}],"key":"MlOIU7SfAV"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"STAT C239A and C239B The Statistics of Causal Inference in the Social Science","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"uW3hFuFWVk"}],"key":"k6c0b4h5Bh"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"STAT 240 Nonparametric and Robust Methods","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"VK3GIPuv1p"}],"key":"RKmYGKPd5k"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"STAT 241A Statistical Learning Theory","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"Bd8cQzhIWw"}],"key":"QoH0BDvaPg"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"STAT 241B Advanced Topics in Learning and Decision Making","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"WvBiZeEURr"}],"key":"syTL0gRf4t"},{"type":"paragraph","position":{"start":{"line":59,"colu