"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"STAT 272 Statistical Consulting","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"R4umMfuOyx"}],"key":"CV4Zq6Vfs7"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Advanced Topic Courses","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"IEok2gxCzY"}],"identifier":"advanced-topic-courses","label":"Advanced Topic Courses","html_id":"advanced-topic-courses","implicit":true,"key":"v3SBJx1P2W"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"These courses are not taught regularly, and the content varies from semester to semester and by instructor. Topic announcements are usually made at the end of the preceding semester. These courses can be taken repeatedly for credit by graduate students, and the department encourages people to take these for credit in order to show the university that there really are people taking these courses. The three advanced topics course titles are:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"kzyoKViU3P"}],"key":"CrYq1fGFvo"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Stat 206: Stochastic Processes","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"m2PJSlFkUQ"}],"key":"jAmLoD09fN"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Stat 212: Topics in Theoretical Statistics","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"YQCdY3obnn"}],"key":"lszvRTKYTQ"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":8