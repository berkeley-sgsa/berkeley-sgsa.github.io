n":1}},"key":"L1k2DntVBo"}],"key":"mgEnAHgnsK"}],"key":"x4nMStseIr"}],"key":"cmSuHduMT8"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Statement of Purpose Workshop","url":"/sop-workshop","group":"Outreach"},"next":{"title":"Foosball","url":"/foosball","group":"Social"}}},"domain":"http://localhost:3000"}