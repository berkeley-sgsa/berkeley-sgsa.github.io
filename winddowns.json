{"version":3,"kind":"Article","sha256":"1b00d92eb546bc17ac2125a870b130941628234390d4a06821485788c34c3b96","slug":"winddowns","location":"/pages/winddowns.md","dependencies":[],"frontmatter":{"title":"Social Events","content_includes_title":false,"github":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io/blob/main/pages/winddowns.md","edit_url":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io/edit/main/pages/winddowns.md","thumbnail":"/build/social-com-a67dc5ebcecc66101ccdf80af7c42eed.png","exports":[{"format":"md","filename":"winddowns.md","url":"/build/winddowns-2929b89cf7352138d3f5e2a3dd421279.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/social-com-a67dc5ebcecc66101ccdf80af7c42eed.png","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aDmrwUfuOS","urlSource":"/assets/social/social-com.png"},{"type":"heading","depth":2,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Weekly events","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Xa2JKuK2jI"}],"identifier":"weekly-events","label":"Weekly events","html_id":"weekly-events","implicit":true,"key":"xwJCw5SWcJ"},{"type":"heading","depth":3,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Friday Wind-Down","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zHiTO5CygP"}],"identifier":"friday-wind-down","label":"Friday Wind-Down","html_id":"friday-wind-down","implicit":true,"key":"rY33vr1ZVh"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"On Friday evenings, the grad students celebrate the arrival of the weekend by eating, drinking or doing some activity near Berkeley at the Friday Wind-Down. Friday night wind downs are weekly-occurring events hosted by the SGSA for graduate students to socialize and “wind down” from the week. Events range from going out to restaurants, outside activities (e.g., kayaking), bars, and events in Evans.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"WdS5mw98Ms"}],"key":"GKGCs6jYQT"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Students are generally summoned to the wind-down (or “wine-down” if said quickly) by the cry of a comical email, occasionally including photo-shopped pictures of former Berkeley professors, such as Jerzy Neyman.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"EKWWZswSqi"}],"key":"eWPwx2I6fj"},{"type":"heading","depth":3,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Tuesday Cookie Hour","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"wvbosG7sz6"}],"identifier":"tuesday-cookie-hour","label":"Tuesday Cookie Hour","html_id":"tuesday-cookie-hour","implicit":true,"key":"f1mjL8uDO3"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Each Tuesday afternoon, members of the department gather for an hour of cookies and pleasant\nconversation. Some call this gathering “Cookie Hour”. Sometimes, students choose to eat fruit.\nThey are accepted nonetheless.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Haz42Fpdax"}],"key":"sJDvZQ4ldc"},{"type":"heading","depth":2,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Semesterly events","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"yRl8kHIM0U"}],"identifier":"semesterly-events","label":"Semesterly events","html_id":"semesterly-events","implicit":true,"key":"RoqhpeZ9fJ"},{"type":"heading","depth":3,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Berkeley–Stanford Colloquium","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"oidV7JBtif"}],"identifier":"berkeley-stanford-colloquium","label":"Berkeley–Stanford Colloquium","html_id":"berkeley-stanford-colloquium","implicit":true,"key":"wVXvQo62pJ"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Since before 1960, the statistics departments of Berkeley and Stanford have been organizing a joint colloquium. Erich Lehmann in his book “Reminiscences of a Statistician: The Company I Kept” describes this traditional program:","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ie6jX3pJb2"}],"key":"HPzF985Ist"},{"type":"blockquote","position":{"start":{"line":24,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"One regular joint program of the two departments has been the\nBerkeley–Stanford Colloquium (by some at Stanford called the\nStanford–Berkeley Colloquium), which has now been in existence for over fifty\nyears. It meets regularly once a semester, alternately at the two\ninstitutions, with the guests providing the speaker. The colloquium talk is\npreceded by refreshments and followed by a reception.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"mW7BSG87n0"}],"key":"hI9ED5BgHV"}],"key":"N8lHyCI8qj"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Foosball Tournament","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"eU6cETOFx6"}],"identifier":"foosball-tournament","label":"Foosball Tournament","html_id":"foosball-tournament","implicit":true,"key":"vI3byfjhxu"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Once a semester, we host a foosball tournament, where the winner is awarded eternal glory and\nsome chocolate or flowers. See ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"z9YVOxFXjm"},{"type":"link","url":"/foosball","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"foosball page","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Q7S4yfAfiI"}],"urlSource":"/pages/foosball.md","dataUrl":"/foosball.json","internal":true,"protocol":"file","key":"KHV5u5tyaz"},{"type":"text","value":" for more details.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"pUhhGUikqY"}],"key":"SpgoMwR44J"},{"type":"heading","depth":2,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Annual events","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"lrYdVUPPuR"}],"identifier":"annual-events","label":"Annual events","html_id":"annual-events","implicit":true,"key":"D1PSeWlPcF"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"There are two major department-wide socializing events with food, drinks and chance to catch\nup: the Spring Picnic and the Fall Party.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"M7YK9rq4eU"}],"key":"k4l9Ff34X0"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The Fall Party","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"nnfTD98KZ2"}],"identi