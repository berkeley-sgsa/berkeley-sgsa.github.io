{"version":3,"kind":"Article","sha256":"cfe428e9ecba6cae7ac0694b7532aaa7a194844a508b7bb0d3a975d90fddd6e3","slug":"funding","location":"/pages/funding.md","dependencies":[],"frontmatter":{"title":"Funding","content_includes_title":false,"github":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io/blob/main/pages/funding.md","edit_url":"https://github.com/berkeley-sgsa/berkeley-sgsa.github.io/edit/main/pages/funding.md","exports":[{"format":"md","filename":"funding.md","url":"/build/funding-320d6d70b451e449d9af3dc45aece663.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Where does funding go?","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"huM8c6xl9M"}],"identifier":"where-does-funding-go","label":"Where does funding go?","html_id":"where-does-funding-go","implicit":true,"key":"QBVBQkRdaf"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Funding goes towards two things:","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"PFeS60P7s0"}],"key":"TKvqg8hDPL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Your personal income (for rent, food, etc.)","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"DNGE25nrVt"}],"key":"V3047snMb7"}],"key":"t8L98HM0Hi"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tuition and fees","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Ae6NDFA4H4"}],"key":"zeMvr8N15z"}],"key":"bJp1UCLyqH"}],"key":"mXb1t4sQxe"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"As we are students, we technically “pay tuition” at Berkeley. This allows us to take classes, use the gym, etc. But we never actually pay this tuition money ourselves---funding will cover it without ever passing through your bank account.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"d8ZZ1z7h0X"}],"key":"SfH034Myid"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Note that no tuition payments are made in the summer.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ZZp1ieKrTL"}],"key":"AojUPYes88"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Sources of funding","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"cufZnnXfDF"}],"identifier":"sources-of-funding","label":"Sources of funding","html_id":"sources-of-funding","implicit":true,"key":"wxRDdoWrmp"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"If you teach (TA) at UC Berkeley as a graduate student, you are a “Graduate Student Instructor” or “GSI”. If you are funded by a professor to do research, you are a “Graduate Student Researcher” or “GSR”. Assuming you don’t have any fellowships, you will typically be on 50% (20hr/week) GSI or GSR in the fall and spring, and 100% (40hr/week) GSR in the summer. If no research funding is available for the summer, you can choose to GSI 100% instead, or do 50/50.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"c4kEQxv0qd"}],"key":"K7GEe5etwY"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"GSI","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"J1AHL18Xd2"}],"identifier":"gsi","label":"GSI","html_id":"gsi","implicit":true,"key":"PwuRGqYRhB"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"This is a position as an employee of UC Berkeley, where your job is to teach. See the ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"eJeG8lvAtu"},{"type":"link","url":"https://sgsa.berkeley.edu/pages/teaching.html","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"teaching","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"qkfqiLrrOW"}],"urlSource":"https://sgsa.berkeley.edu/pages/teaching.html","key":"cb04dhOZpX"},{"type":"text","value":" page for details!","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"faT43xTqoY"}],"key":"tJTtDbonDm"},{"type":"heading","depth":3,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"GSR","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"uaF5gCptCo"}],"identifier":"gsr","label":"GSR","html_id":"gsr","implicit":true,"key":"LEV3lpkwm8"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"This is a position as an employee of UC Berkeley, where your job is to do research under a professor and your “supervisor” is that professor. It is funded by a professor’s research grants. You should definitely try to secure GSR positions in the summers, as it is cheaper for the professors (since they don’t have to pay your tuition in the summer). A good rule is to try to secure a position before spring break.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"sZSnM2mdN7"}],"key":"sHUuxmGOI2"},{"type":"heading","depth":3,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Fellowships","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"v0V31M5cSg"}],"identifier":"fellowships","label":"Fellowships","html_id":"fellowships","implicit":true,"key":"bWPZ6acOJx"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"The main benefit of a fellowship is that it reduces how much you need to GSI or scrounge around for GSR positions. Fellowships will provide either partial or total coverage of your tuition and stipend. If it is partial, you may still need to get GSI or GSR positions, but at a smaller workload (e.g. 25% or 10hr/week) or less often (e.g. GSI/GSR in Fall, rely on fellowship income in Spring). Some fellowships may allow you to make double income (e.g. fellowship+GSI in a given semester), but in general you should not count on a fellowship increasing your total yearly income. See the ","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"k7aSQpSgS2"},{"type":"link","url":"https://sgsa.berkeley.edu/pages/fellowships.html","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"fellowships","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"QaUTNdswyR"}],"urlSource":"https://sgsa.berkeley.edu/pages/fellowships.html","key":"E51vfaC5xN"},{"type":"text","value":" page for information on specific fellowships.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Fp3y0NvbXa"}],"key":"JcqrSbQEoG"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Residency status","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"DN6LNSeQQS"}],"identifier":"residency-status","label":"Residency status","html_id":"residency-status","implicit":true,"key":"VdiWntlSFY"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Your California residency status changes, through “non-resident supplementary tuition” (NRST), how much tuition is paid for you at Berkeley (by whatever funding source you have). If you can, it is important to establish residency in California as soon as possible (the earliest possible date is by the summer after first year). Not all fellowships will be willing to cover your NRST, it may be harder to get a GSR appointment with a professor (as they will pay more for you).","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"tVok2C4EZl"}],"key":"vcKW5UjMta"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Note that California residency status for the purposes of taxes, the state, etc. is distinct from California residency status for the purpose of UC Berkeley. It is a little harder to acquire, but should be no problem (undergrads are the ones who have a tough time).","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"q9bAxGu3Ey"}],"key":"ixvtsgeSQU"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Taxes","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"TS1cnfeAe1"}],"identifier":"taxes","label":"Taxes","html_id":"taxes","implicit":true,"key":"SeKBbD34Ak"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Federal and state taxes for a calendar year are due on April 15 the following calendar year (sometimes a couple days later). Here are some important points:","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"riAtokb4oQ"}],"key":"by40e80Gw9"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":41,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Any money you receive from a fellowship which goes to your bank account and not to tuition/fees ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"TddiGFNFrR"},{"type":"link","url":"https://www.irs.gov/taxtopics/tc421","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"counts as taxable income","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"cd9ABlpQ4T"}],"urlSource":"https://www.irs.gov/taxtopics/tc421","key":"IHtKABEf3f"},{"type":"text","value":"! Even though you’re not “employed” as a GSR/GSI/whatever, you still owe taxes on the income. Choosing not to report fellowship income would be tax evasion.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"X5Tn2mEGOZ"}],"key":"qkPiVf82z8"}],"key":"EU9I6iSrZq"},{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"GSR/GSI income, like any employment income, has “withholding” done on it, where the university will estimate what your taxes will be based on your income and take money out of your paycheck to pay taxes. If all of your income is as a GSR or GSI, then you will probably not owe much in taxes, or will get a tax refund.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"mVdu3QwQBB"}],"key":"t1LTCgcXyW"}],"key":"DCDCckk6E1"},{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fellowship income has no “withholding” done on it. If a lot of your income in a year is fellowship income, you will probably owe a LOT of money when you pay taxes. Students have been known to owe over $5000. It’s important to try to estimate how much you will owe so you can have enough liquid money set aside!","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"V6WBKqYZlY"}],"key":"NfEiJyGNkm"}],"key":"JyJOzvRYo6"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If you know the bulk of your income in a given year will be fellowship income, it may be wise to pay estimated ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"JApKMkgGY9"},{"type":"link","url":"https://www.irs.gov/businesses/small-businesses-self-employed/estimated-taxes","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"federal","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"XKxrev5jT8"}],"urlSource":"https://www.irs.gov/businesses/small-businesses-self-employed/estimated-taxes","key":"prvCEbAlnU"},{"type":"text","value":" and ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"dtp7sWdRqC"},{"type":"link","url":"https://www.ftb.ca.gov/pay/estimated-tax-payments.html","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"state","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"sGiGZqwOMK"}],"urlSource":"https://www.ftb.ca.gov/pay/estimated-tax-payments.html","key":"FIXQO735uO"},{"type":"text","value":" taxes every quarter to avoid an underpayment penalty at the end of the year (although the penalties aren’t very high).","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"dZDFifP3gG"}],"key":"AMQGhDkqUq"}],"key":"HoFCABaoKO"},{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"International students can fill our their taxes through the unversity’s “GLACIER” system. Domestic students can use online software.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"XViU94hkKc"}],"key":"pVM4LJ5zI2"}],"key":"px7TE46tN5"}],"key":"u40ybYn9ct"}],"key":"QY9ObgYqT1"}],"key":"j8X9vJL6tl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Fellowships","url":"/fellowships","group":"Academic"},"next":{"title":"Union","url":"/union","group":"Academic"}}},"domain":"http://localhost:3000"}